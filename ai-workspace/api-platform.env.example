# ---------------------------------------------------------------------------
# Copy to ai-workspace/api-platform.env. 
# ---------------------------------------------------------------------------

# Local values, fine as they are for a local run.
# Where AI Workspace is reached in the browser.
APIP_AIW_DOMAIN=localhost:9643
# How AI Workspace reaches its own Platform API inside Docker. The local
# certificate only covers localhost, so the check is skipped here; a server
# uses its public hostname and a real certificate instead.
APIP_AIW_CONTROL_PLANE_URL=https://platform-api:9243
APIP_AIW_CONTROL_PLANE_TLS_SKIP_VERIFY=true
# The address gateways are told to connect to.
APIP_AIW_GATEWAY_CONTROLPLANE_HOST=localhost:9243
# The API Portal, and how it reaches the Platform API.
APIP_AP_SERVER_BASE_URL=https://localhost:9543
APIP_AP_AUTH_LOCAL_PLATFORM_API_URL=https://platform-api:9243
APIP_AP_AUTH_LOCAL_TLS_SKIP_VERIFY=true

# Admin login for AI Workspace. scripts/generate-local-certs.sh fills in the
# password hash.
APIP_CP_ADMIN_USERNAME=admin
APIP_CP_ADMIN_PASSWORD_HASH=
APIP_CP_LOGGING_LEVEL=debug
