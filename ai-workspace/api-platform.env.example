# Local values (safe to keep as-is for a local run):
APIP_AIW_DOMAIN=localhost:9643
APIP_AIW_CONTROL_PLANE_URL=https://platform-api:9243
# Our self-signed cert only covers localhost/127.0.0.1, not the Compose
# service name "platform-api" this internal hop uses — skip verification
# for local dev (prod uses the public hostname + a CA-issued cert instead).
APIP_AIW_CONTROL_PLANE_TLS_SKIP_VERIFY=true
APIP_AIW_GATEWAY_CONTROLPLANE_HOST=localhost:9243
APIP_AP_SERVER_BASE_URL=https://localhost:9543
APIP_AP_AUTH_LOCAL_PLATFORM_API_URL=https://platform-api:9243
APIP_AP_AUTH_LOCAL_TLS_SKIP_VERIFY=true

# Admin login for https://localhost:9643 — generated by scripts/generate-local-certs.sh
APIP_CP_ADMIN_USERNAME=admin
APIP_CP_ADMIN_PASSWORD_HASH=
APIP_CP_LOGGING_LEVEL=debug
