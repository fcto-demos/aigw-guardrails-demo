# Local values (safe to keep as-is for a local run):
GATEWAY_CONTROLLER_HOST=gateway-controller
LOG_LEVEL=info

# Admin login for the controller's basic auth — generated by scripts/generate-local-certs.sh
APIP_GW_CONTROLLER_AUTH_BASIC_ADMIN_USERNAME=admin
APIP_GW_CONTROLLER_AUTH_BASIC_ADMIN_PASSWORD_HASH=

# Registered against the local ai-workspace control plane on first run --
# generated by scripts/python/provision_showcases.py. Leave blank.
APIP_GW_CONTROLLER_CONTROLPLANE_HOST=
APIP_GW_CONTROLLER_CONTROLPLANE_TOKEN=
APIP_GW_CONTROLLER_CONTROLPLANE_INSECURE_SKIP_VERIFY=

# APIP_GW_ANALYTICS_PUBLISHERS_MOESIF_APPLICATION_ID is set in
# ../secrets/api-keys.env.example instead -- it's a third-party credential
APIP_GW_ANALYTICS_PUBLISHERS_MOESIF_APPLICATION_ID=<value>
# Defaults to "false" (see config.toml's own comment) -- local dev gets this
# from demo.env's ANALYTICS_MODE automatically; the VM has no such script,
# so set it to "true" by hand here once the id above is real.
APIP_GW_ANALYTICS_ENABLED=<value>
