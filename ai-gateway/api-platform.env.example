# ---------------------------------------------------------------------------
# Copy to ai-gateway/api-platform.env.
# ---------------------------------------------------------------------------

# Local values, fine as they are for a local run.
GATEWAY_CONTROLLER_HOST=gateway-controller
LOG_LEVEL=info

# Admin login for the gateway's management API. scripts/generate-local-certs.sh
# fills in the password hash.
APIP_GW_CONTROLLER_AUTH_BASIC_ADMIN_USERNAME=admin
APIP_GW_CONTROLLER_AUTH_BASIC_ADMIN_PASSWORD_HASH=

# How the gateway connects to AI Workspace. scripts/python/provision_showcases.py
# fills these in when it registers the gateway: leave them blank.
APIP_GW_CONTROLLER_CONTROLPLANE_HOST=
APIP_GW_CONTROLLER_CONTROLPLANE_TOKEN=
APIP_GW_CONTROLLER_CONTROLPLANE_INSECURE_SKIP_VERIFY=

# Moesif analytics. Locally, run-local.sh takes the id from
# secrets/api-keys.env and turns analytics on from demo.env's ANALYTICS_MODE,
# so leave these blank. On a server without the scripts, set the id and "true".
APIP_GW_ANALYTICS_PUBLISHERS_MOESIF_APPLICATION_ID=
APIP_GW_ANALYTICS_ENABLED=
