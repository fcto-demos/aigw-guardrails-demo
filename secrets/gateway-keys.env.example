# Gateway-issued per-lane api-key-auth keys.
#
# Normally you never edit this by hand: ./scripts/provision_showcases.py
# (what reset-and-setup.sh calls) creates secrets/gateway-keys.env itself,
# straight from each LlmProxy's issued key.
#
# This template only matters if you wire the gateway by hand instead (e.g.
# creating the LlmProvider/LlmProxy yourself in the AI Workspace UI) -- copy
# it to secrets/gateway-keys.env and paste in each proxy's key. A showcase
# left blank still loads its card but refuses to chat -- see
# ai-chatbot/config.env's header for why.
# --- Default provider (Anthropic) -----------------------------------------
# Unsuffixed names. GATEWAY_API_KEY is the fallback for plain-chat only, not
# a shared key for every lane below it.
GATEWAY_API_KEY=
SHOWCASE_PLAIN_CHAT_API_KEY=
SHOWCASE_SPEND_LIMIT_API_KEY=
SHOWCASE_PROMPT_INJECTION_API_KEY=
SHOWCASE_SEMANTIC_CACHING_API_KEY=
SHOWCASE_SEMANTIC_ROUTING_API_KEY=
SHOWCASE_TIME_BASED_ROUTING_API_KEY=
SHOWCASE_COST_BASED_ROUTING_API_KEY=
SHOWCASE_PII_MASKING_API_KEY=
SHOWCASE_MODEL_FAILOVER_API_KEY=

# --- Mistral -----------------------------------------------------------
SHOWCASE_PLAIN_CHAT_MISTRAL_API_KEY=
SHOWCASE_SPEND_LIMIT_MISTRAL_API_KEY=
SHOWCASE_PROMPT_INJECTION_MISTRAL_API_KEY=
SHOWCASE_SEMANTIC_CACHING_MISTRAL_API_KEY=
SHOWCASE_SEMANTIC_ROUTING_MISTRAL_API_KEY=
SHOWCASE_TIME_BASED_ROUTING_MISTRAL_API_KEY=
SHOWCASE_COST_BASED_ROUTING_MISTRAL_API_KEY=
SHOWCASE_PII_MASKING_MISTRAL_API_KEY=
SHOWCASE_MODEL_FAILOVER_MISTRAL_API_KEY=

# --- Gemini --------------------------------------------------------------
# No SHOWCASE_SEMANTIC_ROUTING_GEMINI_*: Gemini addresses the model via the
# URL path, and semantic-model-routing hard-rejects anything but a payload
# model field -- see ai-chatbot/config.env's own comment on this lane.
SHOWCASE_PLAIN_CHAT_GEMINI_API_KEY=
SHOWCASE_SPEND_LIMIT_GEMINI_API_KEY=
SHOWCASE_PROMPT_INJECTION_GEMINI_API_KEY=
SHOWCASE_SEMANTIC_CACHING_GEMINI_API_KEY=
SHOWCASE_TIME_BASED_ROUTING_GEMINI_API_KEY=
SHOWCASE_COST_BASED_ROUTING_GEMINI_API_KEY=
SHOWCASE_PII_MASKING_GEMINI_API_KEY=
SHOWCASE_MODEL_FAILOVER_GEMINI_API_KEY=
