# ---------------------------------------------------------------------------
# The keys the gateway issues for each card, one per card and provider. Git
# ignores secrets/gateway-keys.env.
#
# You normally never write this file: scripts/python/provision_showcases.py
# creates it with every key. Copy this template only if you set up the cards by
# hand in AI Workspace, then paste each card's key. A card without a key still
# shows, but the gateway refuses its messages.
# ---------------------------------------------------------------------------

# --- Anthropic (the default provider: names without a provider suffix) -------
# Used by Plain chat when it has no key of its own.
GATEWAY_API_KEY=
SHOWCASE_PLAIN_CHAT_API_KEY=
SHOWCASE_SPEND_LIMIT_API_KEY=
SHOWCASE_TOKEN_QUOTA_API_KEY=
SHOWCASE_PROMPT_INJECTION_API_KEY=
SHOWCASE_TOPIC_GUARDRAIL_API_KEY=
SHOWCASE_PROMPT_DECORATION_API_KEY=
SHOWCASE_AUDIT_LOG_API_KEY=
SHOWCASE_PII_MASKING_API_KEY=
SHOWCASE_CONTENT_SAFETY_API_KEY=
SHOWCASE_CONTENT_SAFETY_BEDROCK_API_KEY=
SHOWCASE_LINK_CHECK_API_KEY=
SHOWCASE_MARKUP_GUARD_API_KEY=
SHOWCASE_SECRET_GUARD_API_KEY=
SHOWCASE_SEMANTIC_CACHING_API_KEY=
SHOWCASE_PROMPT_COMPRESSION_API_KEY=
SHOWCASE_SEMANTIC_ROUTING_API_KEY=
SHOWCASE_TIME_BASED_ROUTING_API_KEY=
SHOWCASE_COST_BASED_ROUTING_API_KEY=
SHOWCASE_MODEL_FAILOVER_API_KEY=
SHOWCASE_MODEL_CANARY_API_KEY=

# Cards that span two providers, whatever the provider picker says.
SHOWCASE_INTELLIGENT_ROUTING_API_KEY=
