# ---------------------------------------------------------------------------
# Copy to secrets/content-safety.env for the Content safety cards (see the
# README's prerequisites). Fill in the services you have:
# a card whose service is left blank is not set up.
# ---------------------------------------------------------------------------

# Azure Content Safety: your resource's endpoint and key (Azure portal, the
# resource's "Keys and Endpoint" page).
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=

# AWS Bedrock Guardrails: where your guardrail lives, its id and version, and a
# Bedrock API key.
AWS_BEDROCK_REGION=
AWS_BEDROCK_GUARDRAIL_ID=
AWS_BEDROCK_GUARDRAIL_VERSION=DRAFT
AWS_BEARER_TOKEN_BEDROCK=
# Or, instead of the Bedrock API key, an IAM user's access key pair:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# TypeSafe AI's Jev, a model that judges each message: your API key
# (https://console.typesafe.ai/keys).
TYPESAFE_API_KEY=
