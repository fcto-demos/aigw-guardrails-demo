# Copy to secrets/content-safety.env for the Content safety cards (README,
# Prerequisites). Fill in one service or both; a blank one is left out.

# Azure Content Safety: your resource's endpoint and key.
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=

# AWS Bedrock Guardrails: the guardrail's region, id and version, and a
# Bedrock API key.
AWS_BEDROCK_REGION=
AWS_BEDROCK_GUARDRAIL_ID=
AWS_BEDROCK_GUARDRAIL_VERSION=DRAFT
AWS_BEARER_TOKEN_BEDROCK=
# Or, instead of the API key, an IAM user's access key pair:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
