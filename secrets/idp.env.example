# Copy to secrets/idp.env for the MCP Authentication and Authorization cards.
# Setup: .docs/mcp-identity-provider.md
IDP_ISSUER=
# For a provider on this machine: host.docker.internal instead of localhost
IDP_JWKS_URI=
IDP_CLIENT_ID=
# Optional: the provider's admin console, opened from the app's launcher menu
IDP_CONSOLE_URL=
