# ---------------------------------------------------------------------------
# Copy to secrets/idp.env for the MCP Authentication and Authorization cards.
# How to set up the identity provider:
# .docs/mcp-identity-provider.md
# ---------------------------------------------------------------------------

# The issuer your identity provider writes in its tokens.
IDP_ISSUER=
# Where the gateway fetches the provider's signing keys. For a provider running
# on this machine, write host.docker.internal instead of localhost.
IDP_JWKS_URI=
# The app this demo signs users in with.
IDP_CLIENT_ID=
# Optional: the provider's admin console, listed in the app's launcher menu.
IDP_CONSOLE_URL=
