# Optional: take the product images from an external registry instead of the
# public ones. It can be any registry, for example WSO2's: registry.wso2.com.
# Copy this file to secrets/registry.env and fill it in. Git ignores that copy.

# true to use the registry below, false to use the public images.
USE_EXTERNAL_REGISTRY=false
# The registry address and the path to the images, without https://
# (here, WSO2's registry).
EXTERNAL_REGISTRY_URL=registry.wso2.com/wso2-api-platform
# Your account on that registry, and its token (or password).
EXTERNAL_REGISTRY_USERNAME=
EXTERNAL_REGISTRY_TOKEN=
