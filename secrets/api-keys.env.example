# Copy to secrets/api-keys.env and fill in real keys
#
# One key per provider -- see providers.json's secretVar/enabled to skip a
# provider you don't have a key for.
ANTHROPIC_API_KEY=sk-ant-...
MISTRAL_API_KEY=...
GEMINI_API_KEY=...

# Todo for now supports only Mistral Embeddings
# TODO: Configure other provider Embeddings
EMBEDDINGS_PROVIDER_API_KEY=...

# Moesif analytics (config.toml's [analytics]). Get it from your Moesif
# account: app settings -> API keys -> Application ID. Blank = off locally.
APIP_GW_ANALYTICS_PUBLISHERS_MOESIF_APPLICATION_ID=
