# Copy to config.env and edit. Real environment variables override this file.

# The gateway address is not set here: the cards call the same gateway as the
# provisioning, this machine's or the REMOTE_ one in ../demo.env.

# --- gateway api-key-auth -------------------------------------------------
# GATEWAY credentials, never Anthropic ones -- the gateway holds that key
# and it never reaches this app. Attached to every lane: a request with no
# key gets 401 before any policy runs.
#
# Every lane gets its OWN key (api-key-auth rejects a key issued for a
# different provider -- verified on this gateway); jwt-auth would be needed
# for one shared key across lanes instead.
#
# Header name must match the policy's `key` parameter.
GATEWAY_API_KEY_HEADER=API-Key

# The keys themselves (GATEWAY_API_KEY -- fallback for a lane with none of
# its own -- plus every SHOWCASE_*_API_KEY, provider-prefixed except the
# default one) do NOT go in this file: real credentials, gitignored in
# ../secrets/gateway-keys.env instead (copy from
# ../secrets/api-keys.env.example for the shape, or let
# provision_showcases.py generate them). A lane with no key still loads its
# card; the gateway answers 401, which /health predicts as "keyed": false.

# --- app settings ------------------------------------------------------------
# No MODEL var: the default is always each provider's own fast/cheap model
# from providers.json (the gateway's routers choose what actually answers;
# the page reads it back from message_start). --model overrides this for
# every showcase with a literal id:
#   ./server.py --model claude-opus-4-6
# Register the model on the provider first -- the hosted provider ships
# claude-opus-5 and claude-opus-4-6 only (adding one resets the cost-budget
# counter). Avoid claude-opus-5 for cost-tracked lanes: no pricing-file
# entry, so llm-cost records $0.0000000000 and the budget never moves.

# Keep this generous: a reasoning model spends output tokens on internal
# reasoning before writing anything, so a small budget can return no text at
# all -- verified at 32 tokens on this gateway.
MAX_TOKENS=2048

# The operator name shown in the wordmark, the page title and the system
# prompt. Change this one value to rebrand the whole app.
BRAND_NAME=Acme Mobile

# Markdown file of product facts appended to the system prompt -- the
# assistant's only source of plan/price/allowance detail. Blank it to go
# back to "I don't have the live plan list".
PLANS_FILE=plans.md

# {brand} is substituted with BRAND_NAME. Leave empty to send no system
# prompt. The "never name real operators" clause keeps real telecom brands
# out of the answers.
SYSTEM_PROMPT=You are the AI assistant for {brand}, a mobile network operator. Be warm, concise and practical. Never name, recommend or compare real-world mobile operators, networks or consumer brands, and never cite an external website. Refer to the operator only as {brand}.

# The hosted host presents a certificate the PoC scripts already bypass.
TLS_VERIFY=false

# ---------------------------------------------------------------------------
# Per-showcase providers
#
# Each showcase talks to its own LLM provider; the app never configures the
# gateway. No SHOWCASE_*_CONTEXT var: context is always
# /<providerId>-<contextSuffix> (bare /<providerId> if empty), computed by
# server.py from providers.json + showcases.json's contextSuffix. Add a
# provider's key below (see api-key-auth) and the showcase is wired.
#
# A showcase with no key is "unwired": its card still loads and explains
# itself, but refuses to chat rather than silently falling back to the plain
# provider and implying the capability works.
# ---------------------------------------------------------------------------

# --- spend-limit / cost-based-routing ---------------------------------------
# No STREAM var for either lane: both need stream:false for an unrelated
# reason -- llm-cost reports $0 for a STREAMED response and the budget never
# charges (DEBUG logs: streamed says "reported cost is zero, budget not
# charged"; non-streamed charges a real amount). Confirmed on all three
# providers, so it's set once via gateway.stream: false in showcases.json,
# not a per-provider override. See TECH_DEBT.md.

# --- prompt-injection lane -----------------------------------------------------
# A showcase can be pinned to a full URL of its own, or
# given its own model, token ceiling or system prompt:
#   SHOWCASE_PROMPT_INJECTION_URL=https://elsewhere:8443/guard/v1/messages
#   SHOWCASE_PROMPT_INJECTION_MODEL=claude-haiku-4-5
#   SHOWCASE_PROMPT_INJECTION_MAX_TOKENS=1024
#   SHOWCASE_PROMPT_INJECTION_SYSTEM_PROMPT=...
#
# prompt-injection is the one that wants a permissive system prompt: the
# stock prompt already refuses to disclose itself, so a refusal there proves
# nothing -- the guardrail needs to be the only thing stopping the answer.

# Markers that identify a deliberate policy refusal, not a fault, so the UI
# can paint a guardrail block as the success it is. regex-guardrail refuses
# with 422 (not the 400 the docs imply) and returns a structured body, so
# GUARDRAIL_INTERVENED,REGEX_GUARDRAIL is a real second signal alongside
# showcases.json's own gateway.blockStatus.
POLICY_BLOCK_HEADERS=
POLICY_BLOCK_MARKERS=
