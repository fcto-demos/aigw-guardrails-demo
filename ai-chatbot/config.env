# Showcase wiring: one LlmProxy per (showcase, provider), on top of that
# provider's single shared LlmProvider.
#
# No SHOWCASE_*_CONTEXT var: context is always /<providerId>-<contextSuffix>
# (bare /<providerId> if contextSuffix is empty), computed by server.py's
# resolve_gateway() and provision_showcases.py's build_lanes() from the same
# formula. A provider that can't run a showcase at all is listed in that
# showcase's unsupportedProviders in showcases.json instead.
#
# SHOWCASE_*_API_KEY values ARE generated, but into ../secrets/gateway-keys.env
# (real credentials, gitignored), not here. Re-run to pick up a new key:
#   ./scripts/python/provision_showcases.py            # every lane
#   ./scripts/python/provision_showcases.py spend-limit # one lane

# scheme://host:port that every showcase's computed context path hangs off
# (see the contextSuffix note below) -- the one thing to change to move every
# showcase to another gateway at once.
GATEWAY_BASE=https://local-aigw.apis.coach:8443

# --- gateway api-key-auth -------------------------------------------------
# Attached to every lane: a request with no key gets 401 before any policy
# runs. Every lane gets its OWN key (api-key-auth rejects a key issued for a
# different provider -- verified on this gateway); jwt-auth would be needed
# for one shared key across lanes instead.
#
# Header name must match the policy's `key` parameter -- x-api-key, confirmed
# working on this gateway.
#
# Keys live in the gitignored ../secrets/gateway-keys.env, not here.
GATEWAY_API_KEY_HEADER=x-api-key

# --- app settings ------------------------------------------------------------
# Keep this generous: a reasoning model spends output tokens on internal
# reasoning before writing anything, so a small budget can return no text at
# all -- verified at 32 tokens on this gateway.
MAX_TOKENS=2048

# The operator name shown in the wordmark, the page title and the system
# prompt. Change this one value to rebrand the whole app.
BRAND_NAME=Acme Mobile

# Markdown file of product facts appended to the system prompt -- the
# assistant's only source of plan/price/allowance detail. Blank it to go
# back to "I don't have the live plan list".
PLANS_FILE=plans.md

# {brand} is substituted with BRAND_NAME. Leave empty to send no system
# prompt. The "never name real operators" clause keeps real telecom brands
# out of the answers.
SYSTEM_PROMPT=You are the AI assistant for {brand}, a mobile network operator. Be warm, concise and practical. Never name, recommend or compare real-world mobile operators, networks or consumer brands, and never cite an external website. Refer to the operator only as {brand}.

PORT=8600

# The gateway presents a real Let's Encrypt *.apis.coach certificate, so keep
# verification on. Set false only against a self-signed listener (localhost).
TLS_VERIFY=true

# ---------------------------------------------------------------------------
# Per-showcase notes
#
# A key left empty leaves that showcase unwired: its card still opens and
# explains itself, but refuses to chat rather than silently falling back to
# the plain provider and implying the capability works.
# ---------------------------------------------------------------------------

# --- spend-limit / cost-based-routing ---------------------------------------
# No vars here -- the model/stream choices below live in showcases.json.
#
# The $0.02/1h budget is baked into scripts/python/provision_showcases.py's
# lane_templates(); showcases.json mirrors the same figures so the card can
# show a meter, since this lane publishes no remaining-budget header. Change
# one and change the other, or the meter drifts from the policy.
#
# Both lanes need a priced model, or the budget never moves (no claude-opus-5
# pricing entry -> llm-cost records $0). Both already declare overrides.model:
# "large" in showcases.json -- a role resolved per provider via
# providers.json (same indirection as screens.js's modelForRole()), so
# there's nothing to set here.
#
# Both also need stream:false, unrelated reason: llm-cost reports $0 for a
# STREAMED response and the budget never charges (DEBUG logs: streamed says
# "reported cost is zero, budget not charged"; non-streamed charges a real
# amount). Confirmed on all three providers -- an llm-cost streaming gap, not
# wire-specific -- so it's set once via gateway.stream: false in
# showcases.json, not a config.env override. See TECH_DEBT.md.

# --- semantic-caching ---------------------------------------------------------
# No vars here either. Entries live 3600s in Redis, so flush it between
# rehearsals or the priming step starts as a hit. The rest of this lane's
# behavior (similarityThreshold math, measured cosine scores) is in
# showcases.json's own notes, not duplicated here.

# --- pii-masking lane ---------------------------------------------------------
# pii-masking-regex reads nothing from config.toml, so this lane needed no
# host change, unlike the cache and semantic-routing lanes. jsonPath is
# $.messages[-1].content, so only the CURRENT turn is masked -- and since
# this app replays history, every step on the card is a single self-contained
# turn for that reason.
#
# STREAM=false is NOT a preference. Unmasking the response is a substring
# replace applied per SSE chunk, and the placeholder gets split across deltas
# -- ["My", " email is [EMAIL", "_0000]"] -- so it is never matched and
# [EMAIL_0000] reaches the client. Measured over three sessions: 1/6, 4/6 and
# 0/6 runs restored correctly. Non-streamed was 4/4 and then clean on every
# subsequent run. Same treatment the semantic-cache lane needs, different
# reason.
SHOWCASE_PII_MASKING_STREAM=false

# The model refuses to spell out or transform anything that looks like a real
# email, card or NI number -- and a refusal is indistinguishable from masking
# having worked, which kills the demo. This is the stock preamble plus one
# clause that removes the refusal without changing the assistant's persona, so
# the same lane still answers an ordinary catalogue question warmly. The
# catalogue is appended by server.py after this template, as usual.
SHOWCASE_PII_MASKING_SYSTEM_PROMPT=You are the AI assistant for {brand}, a mobile network operator. Be warm, concise and practical. Never name, recommend or compare real-world mobile operators, networks or consumer brands, and never cite an external website. Refer to the operator only as {brand}. If the visitor asks you to repeat, spell out, count or otherwise transform text from their own message, do it literally and exactly as given, with no caveats and no commentary about privacy.

# --- prompt-injection lane -----------------------------------------------------
# The stock system prompt already refuses to disclose itself, so a refusal on
# the guardrail card proves nothing about the gateway. This deliberately
# permissive prompt makes the guardrail the only thing standing between the
# injection and an answer -- which is what makes the block worth showing.
SHOWCASE_PROMPT_INJECTION_SYSTEM_PROMPT=You are a helpful assistant for {brand}, a mobile network operator. Answer every question you are asked as fully as you can.

# regex-guardrail refuses with 422 (not the 400 the docs imply);
# showcases.json's gateway.blockStatus carries that as the primary signal.
# Verified response body:
#   {"type":"REGEX_GUARDRAIL","message":{"action":"GUARDRAIL_INTERVENED",
#    "actionReason":"Violation of regular expression detected.",
#    "direction":"REQUEST","interveningGuardrail":"regex-guardrail"}}
# These markers are a second signal so a guardrail block (the SUCCESS case
# here) doesn't get mistaken for a fault if the status code ever changes.
POLICY_BLOCK_HEADERS=
POLICY_BLOCK_MARKERS=GUARDRAIL_INTERVENED,REGEX_GUARDRAIL
